# Proposed backend configuration contract. No runtime consumes this file yet.
# Phase 1 desktop shell needs no .env, API key, backend or database.
# Copy to .env only when a backend implementation documents loading it.
# Never put provider keys in VITE_* variables or frontend bundles.

APP_ENV=development
ASSISTANT_NAME=Jarvis
ASSISTANT_LOCALE=vi-VN
ASSISTANT_TIMEZONE=system
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
LOG_LEVEL=INFO

# Select providers/models after the relevant phase evaluation.
VAD_PROVIDER=
STT_PROVIDER=
STT_MODEL=
TTS_PROVIDER=
TTS_MODEL=
TTS_VOICE=
LLM_PROVIDER=
LLM_MODEL=

# Backend only; populate only the selected provider's credentials locally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional from Phase 6; never commit real connection strings.
REDIS_URL=
DATABASE_URL=

# Local session tokens are generated at runtime, not stored here.
