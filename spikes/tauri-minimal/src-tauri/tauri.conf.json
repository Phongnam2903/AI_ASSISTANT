{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri prerequisite spike",
  "version": "0.1.0",
  "identifier": "dev.personalassistant.prerequisitespike",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri prerequisite spike",
        "width": 480,
        "height": 200
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
