# Personal AI Assistant — environment variable template
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development

# --- Data layer (introduced Phase 1 / Phase 4) ---
DATABASE_URL=
REDIS_URL=

# --- LLM providers (introduced Phase 1) ---
# Fill in only the provider(s) you intend to use; LLMProvider abstraction picks one at runtime.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Google OAuth (Calendar / Gmail / Drive — Phase 6) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub integration (Phase 6) ---
GITHUB_TOKEN=
