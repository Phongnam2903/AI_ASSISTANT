{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal AI Assistant",
  "version": "0.1.0",
  "identifier": "dev.personalassistant.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal AI Assistant",
        "width": 400,
        "height": 560,
        "minWidth": 400,
        "minHeight": 560,
        "maxWidth": 400,
        "maxHeight": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "tooltip": "Personal AI Assistant"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
